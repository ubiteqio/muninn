# Muninn configuration template. Copy to deploy/.env and fill in.
# deploy/setup.sh does this for you and generates the secrets.
# Never commit the filled-in file.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=muninn
POSTGRES_DB=muninn
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Origins that may call the API from elsewhere. The web app is served from the same address and
# needs none of this; a phone's app is its own origin and has to be named. Comma-separated.
# MUNINN_CORS_ORIGINS=capacitor://localhost,ionic://localhost,http://localhost

# --- Web app --------------------------------------------------------------------
# Where Muninn is reached, on every interface: http://<this machine>:9090
# The same container passes /api on to the server, so there is one address for everything.
MUNINN_WEB_PORT=9090

# --- API ----------------------------------------------------------------------
# Port on the host, bound to 127.0.0.1. The web container reaches the API inside Docker; this
# is only for looking at /api/v1/docs from the machine itself.
MUNINN_API_PORT=8000
MUNINN_LOG_LEVEL=info

# Signs the access tokens. Generate with: openssl rand -base64 48
# Changing it logs everybody out.
MUNINN_JWT_SECRET=

# Token lifetimes. The refresh token rotates on every use.
MUNINN_ACCESS_TOKEN_TTL_MINUTES=15
MUNINN_REFRESH_TOKEN_TTL_DAYS=30

# The browser keeps the session in a cookie marked "secure", which it only accepts over HTTPS.
# In the house over plain HTTP this has to be false, or every reload asks for the password again.
MUNINN_REFRESH_COOKIE_SECURE=false

# Time zone of the installation, e.g. Europe/Berlin. The nightly full sync runs at the hour
# set in the admin area, and that hour is read in this zone.
TZ=UTC

# --- Media paths on the host --------------------------------------------------
# The NAS library, mounted into the container as /library, read-only.
# Point this at the NFS/SMB mount, for example /mnt/nas/fotos. Left unset, ../data/library is
# used, which is meant for trying Muninn out without a NAS - a library that is suddenly empty
# is refused anyway, see the note below.
MUNINN_LIBRARY_HOST_PATH=../data/library

# The group that owns the library, as a number. Needed where the photos belong to a group of the
# NAS and give no rights to others (drwxrwx---), which is the usual setting for a family share.
# Muninn's containers run as user 1000 and are given this group, so they may read the photos.
#   stat -c '%g' /Volume1/data/images
# MUNINN_LIBRARY_GID=1000

# How many files Huginn reads at the same time.
MUNINN_WORKER_CONCURRENCY=2

# How many previews and 720p videos are made at the same time. Each video keeps a core busy.
MUNINN_DERIVE_CONCURRENCY=2

# How many media go to the AI server at the same time. Raise it only if the GPU keeps up.
MUNINN_AI_CONCURRENCY=2

# Thumbnails, previews and transcodes Muninn generates, mounted as /data/derived.
# Keep this on a local SSD; it can be deleted and rebuilt at any time.
MUNINN_DERIVED_HOST_PATH=../data/derived

# --- Development only (docker-compose.dev.yml) ------------------------------------
# Where PostgreSQL and Redis are reachable on this machine, for tests and the local server.
# MUNINN_POSTGRES_PORT=5432
# MUNINN_REDIS_PORT=6379
