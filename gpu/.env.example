# Konfiguration der KI-Maschine. Kopieren nach gpu/.env und ausfüllen.
# Diese Datei gehört nicht ins Repository.

# Der Schlüssel, den beide Dienste verlangen und den Muninn in seinen KI-Profilen einträgt.
# Erzeugen mit: openssl rand -hex 24   (oder in PowerShell: -join ((48..57)+(97..122) | Get-Random -Count 48 | % {[char]$_}))
AI_API_KEY=

# Das beschreibende Modell. FP8-Gewichte (~10 GB statt 16,6 GB): bf16 passt neben den
# Vektormodellen nicht auf eine Karte mit 24 GB.
VLLM_MODEL=Qwen/Qwen3-VL-8B-Instruct-FP8
# Der Name, unter dem Muninn das Modell anspricht, unabhängig von den geladenen Gewichten.
VLLM_SERVED_NAME=Qwen/Qwen3-VL-8B-Instruct
VLLM_MAX_MODEL_LEN=16384
# Anteil der Karte für vLLM, fest reserviert beim Start. Der Rest bleibt für die Vektormodelle,
# Whisper und den Windows-Desktop. Auf einer 24-GB-Karte reichen 0.66: vLLM behält rund 37.000
# Tokens Cache (Muninn braucht etwa 30.000), und die Karte läuft nicht mehr voll. Bei 0.75 lief
# sie voll, Windows lagerte in den Arbeitsspeicher aus, und alles auf der Karte stand still.
VLLM_GPU_FRACTION=0.66
# Speicher der CUDA-Graphen nicht in den Anteil einrechnen (0, Standard): so bleibt
# VLLM_GPU_FRACTION, was es vor vLLM 0.21 war.
# VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
VLLM_PORT=8000
# Die vLLM-Fassung. Voreingestellt ist eine erprobte; eine neue erst nach einem Blick ins Log
# übernehmen, denn neue Fassungen teilen den Grafikspeicher mitunter anders auf.
# VLLM_VERSION=v0.29.0

# Unter WSL 2 (also Docker Desktop auf Windows) läuft nur der V1-Modell-Läufer: dem neuen fehlt
# der angeheftete Hostspeicher, den WSL nicht anbietet. Auf einer Linux-Maschine kann das auf 1.
VLLM_USE_V2_MODEL_RUNNER=0
# Alternative bei neuem WSL-Kern: dann darf oben auch 1 stehen.
VLLM_WSL2_ENABLE_PIN_MEMORY=0

# Die Vektormodelle und die Spracherkennung.
EMBED_PORT=8100
# Die Namen, unter denen Muninn die Modelle anspricht (Admin → KI), und die Gewichte dahinter.
# EMBED_IMAGE_MODEL_NAME=siglip2
# EMBED_IMAGE_MODEL_ID=google/siglip2-so400m-patch14-384
# EMBED_TEXT_MODEL_NAME=bge-m3
# EMBED_TEXT_MODEL_ID=BAAI/bge-m3
# Erst laden, wenn vLLM antwortet (Standard); leer lädt sofort.
# EMBED_WAIT_FOR=http://vllm:8000/health
# Leer lassen (EMBED_TRANSCRIBE_MODEL_NAME=) schaltet die Spracherkennung ab.
# EMBED_TRANSCRIBE_MODEL_NAME=whisper-large-v3-turbo
# EMBED_TRANSCRIBE_MODEL_ID=openai/whisper-large-v3-turbo
# Wo Whisper läuft: leer (Standard, auf der Karte) oder cpu (gibt der Karte 1,5 bis 2 GB frei).
# EMBED_TRANSCRIBE_DEVICE=

# Gesichter. Leer lassen (EMBED_FACE_MODEL_NAME=) schaltet sie ab. Die Modelle von InsightFace
# sind nur für nichtkommerzielle Nutzung freigegeben; für die eigene Familie passt das.
# EMBED_FACE_MODEL_NAME=buffalo_l
# Grafikspeicher für die Gesichter in MB (Standard 1024).
# EMBED_FACE_MEMORY_MB=1024
# Wo die Gesichter laufen: cpu (Standard, schont den Grafikspeicher) oder cuda.
# EMBED_FACE_DEVICE=cpu
# EMBED_DEVICE=auto
# EMBED_DTYPE=auto
# EMBED_MAX_BATCH=32

# Nur nötig, wenn ein Modell auf Hugging Face eine Zustimmung verlangt.
# HUGGING_FACE_HUB_TOKEN=
